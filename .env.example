# ── Careers form ───────────────────────────────────────────────────────────
# The form POSTs the application + CV to public/apply.php which emails it
# (with the CV attached) to extraclub.az@gmail.com.
#
# FRONTEND: where the form posts. Default /apply.php (same domain).
# If PHP is on another host, set its full URL (and add that origin to the CSP
# connect-src in public/_headers and vercel.json).
# NEXT_PUBLIC_APPLY_ENDPOINT=https://senategroup.az/apply.php
#
# ── apply.php SMTP (REQUIRED for real delivery) ─────────────────────────────
# Plain PHP mail() reports success but Gmail usually drops it. Set these as
# server environment variables on the PHP host (or fill SMTP_PASS in apply.php):
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=ssl
#   SMTP_USER=extraclub.az@gmail.com
#   SMTP_PASS=your-16-char-google-app-password
#
# Google App Password: myaccount.google.com → Security → 2-Step Verification
# → App passwords → generate one for "Mail". Use that (not the normal password).
