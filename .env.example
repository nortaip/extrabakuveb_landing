# Careers form — PHP mail handler
#
# The careers form POSTs the application + CV to a PHP script (public/apply.php)
# which emails it (with the CV attached) to extraclub.az@gmail.com.
#
# By default the form posts to /apply.php on the SAME domain — deploy apply.php
# to your PHP host alongside the site and it just works.
#
# If your PHP lives on a DIFFERENT domain (e.g. https://senategroup.az/apply.php),
# set the full URL here and keep the CORS header in apply.php. You may also need
# to add that origin to the CSP `connect-src` in public/_headers and vercel.json.
# NEXT_PUBLIC_APPLY_ENDPOINT=https://senategroup.az/apply.php
